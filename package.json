{
  "name": "projeto-luna",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "http-server luna_mvp_frontend -a 127.0.0.1 -p 5173 -c-1",
    "start": "node backend/src/server.js",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:push": "node backend/src/db/bootstrap.js",
    "db:studio": "prisma studio --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^10.9.0",
    "openai": "^6.48.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "http-server": "^14.1.1",
    "prisma": "^6.19.3"
  }
}
